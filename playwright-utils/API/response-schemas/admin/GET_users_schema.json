{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["data", "meta", "rels"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "userName", "deleted", "status", "employee", "userRole"],
        "properties": {
          "id": { "type": "integer" },
          "userName": { "type": "string" },
          "deleted": { "type": "boolean" },
          "status": { "type": "boolean" },
          "employee": {
            "type": "object",
            "required": ["empNumber", "employeeId", "firstName", "middleName", "lastName", "terminationId"],
            "properties": {
              "empNumber": { "type": "integer" },
              "employeeId": { "type": ["string", "null"] },
              "firstName": { "type": "string" },
              "middleName": { "type": "string" },
              "lastName": { "type": "string" },
              "terminationId": { "type": ["integer", "null"] }
            }
          },
          "userRole": {
            "type": "object",
            "required": ["id", "name", "displayName"],
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "displayName": { "type": "string" }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["total"],
      "properties": { "total": { "type": "integer" } }
    },
    "rels": { "type": "array" }
  }
}
